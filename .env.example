# Configuración de Turso Serverless
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-auth-token-aqui

# Configuración de AWS Lambda y Powertools
POWERTOOLS_SERVICE_NAME=turso-api-service
LOG_LEVEL=INFO
AWS_SAM_LOCAL=true

# Secreto en AWS Secrets Manager (utilizado en producción)
TURSO_SECRET_NAME=prod/turso/credentials
